{
  "compilerOptions": {
    "target": "ESNext",
    "types": ["node"],
    "strict": true,
    "module": "CommonJS",
    "sourceMap": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "/*": ["./*"],
      "@_config/*": ["./config/*"],
      "@_pw-config": ["./playwright.config.ts"],
      "@_src/*": ["./src/*"]
    }
  },
  "exclude": ["node_modules", "playwright-report", "test-results"]
}
